{
  "name": "dmk-loading",
  "version": "1.0.0",
  "description": "框架无关的过渡动画加载库。装完即用，页面零 import：请求前后调 openLoading()/closeLoading() 即可，遮罩的显示、定位、并发计数、防闪烁全部由库内部接管。core 纯 TS 零运行时依赖，Vue/React/UniApp/鸿蒙 共享同一套逻辑。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue3",
    "react",
    "loading",
    "spinner",
    "transition",
    "mask",
    "overlay",
    "async",
    "concurrency",
    "zero-import",
    "framework-agnostic",
    "accessibility",
    "指令",
    "遮罩",
    "加载",
    "并发",
    "无框架依赖"
  ],
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.umd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./global": {
      "types": "./dist/global.d.ts"
    },
    "./core": {
      "types": "./dist/core/standalone.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css",
    "./dist/index.js"
  ],
  "scripts": {
    "dev": "vite -c vite.dev.config.ts",
    "build": "vue-tsc --noEmit && vite build && vite build -c vite.plugin.config.ts && vite build -c vite.core.config.ts && vue-tsc -p tsconfig.build.json && vue-tsc -p tsconfig.core.json && node scripts/copy-global-dts.mjs",
    "preview": "vite preview",
    "check:sfc": "node scripts/check-sfc.mjs",
    "test": "npm run check:sfc && npm run test:core && npm run test:func && npm run test:auto-import && npm run test:package",
    "test:core": "node scripts/verify-core.mjs",
    "test:func": "node scripts/verify-functional.mjs",
    "test:e2e": "node scripts/e2e-scenarios.mjs",
    "build:core": "vite build -c vite.core.config.ts && vue-tsc -p tsconfig.core.json",
    "test:core-standalone": "node scripts/verify-core-standalone.mjs",
    "build:vite-plugin": "vite build -c vite.plugin.config.ts",
    "test:auto-import": "node scripts/verify-auto-import.mjs",
    "measure:imports": "node scripts/measure-imports.mjs",
    "measure:pages": "node scripts/measure-multi-page.mjs",
    "test:e2e:zero": "node scripts/e2e-zero-import.mjs",
    "prepublishOnly": "npm run build && node scripts/verify-package.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "test:e2e:a11y": "node scripts/e2e-a11y.mjs"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.10"
  },
  "author": {
    "name": "DuanMK"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DuanMK/dmk-loading.git"
  },
  "homepage": "https://github.com/DuanMK/dmk-loading#readme",
  "bugs": {
    "url": "https://github.com/DuanMK/dmk-loading/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
